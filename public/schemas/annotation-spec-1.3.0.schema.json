{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://annotate.omarchoudhry.co.uk/schemas/annotation-spec-1.3.0.schema.json",
  "title": "Research with AI annotation specification",
  "description": "Immutable schema for annotation specifications generated by tutorial release 1.3.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tutorial_version",
    "tutorial_canonical_url",
    "schema_version",
    "project",
    "data",
    "labels",
    "tasks",
    "workflow",
    "ai_assistance",
    "provenance",
    "exports",
    "validation"
  ],
  "properties": {
    "tutorial_version": {
      "const": "1.3.0"
    },
    "tutorial_canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "schema_version": {
      "const": "1.3.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source_manifest",
        "raw_data_immutable",
        "deidentification"
      ],
      "properties": {
        "type": {
          "enum": ["image", "video", "volume", "multimodal"]
        },
        "source_manifest": {
          "type": "string",
          "minLength": 1
        },
        "raw_data_immutable": {
          "const": true
        },
        "deidentification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewer", "decision_reference"],
          "properties": {
            "status": {
              "enum": [
                "not_reviewed",
                "approved",
                "not_applicable",
                "failed"
              ]
            },
            "reviewer": {
              "type": ["string", "null"]
            },
            "decision_reference": {
              "type": ["string", "null"]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": ["approved", "not_applicable", "failed"]
                  }
                },
                "required": ["status"]
              },
              "then": {
                "properties": {
                  "reviewer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decision_reference": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "not_reviewed"
                  }
                },
                "required": ["status"]
              },
              "then": {
                "properties": {
                  "reviewer": {
                    "type": "null"
                  },
                  "decision_reference": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "labels": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tasks": {
      "description": "Task target references are validated by the builder and must match keys in labels.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": ["type"],
              "properties": {
                "type": {
                  "enum": ["classification", "keypoints", "temporal_interval"]
                }
              }
            },
            "then": {
              "properties": {
                "allowed_values": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "required": ["type"],
              "properties": {
                "type": {
                  "const": "temporal_interval"
                }
              }
            },
            "then": {
              "properties": {
                "interval_boundaries": {
                  "type": "string",
                  "enum": [
                    "inclusive_start_exclusive_end",
                    "inclusive_both",
                    "exclusive_both"
                  ]
                }
              }
            }
          }
        ],
        "required": [
          "type",
          "target_label_ids",
          "cardinality",
          "geometry_and_units",
          "allowed_values",
          "missing_values",
          "interval_boundaries"
        ],
        "properties": {
          "type": {
            "enum": [
              "bounding_box",
              "classification",
              "keypoints",
              "polygon_mask",
              "polyline",
              "scalar",
              "temporal_interval"
            ]
          },
          "target_label_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
            }
          },
          "cardinality": {
            "type": "string",
            "minLength": 1
          },
          "geometry_and_units": {
            "type": "string",
            "minLength": 1
          },
          "allowed_values": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
            }
          },
          "missing_values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
            }
          },
          "interval_boundaries": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotators_per_item", "review", "deployment", "autosave"],
      "properties": {
        "annotators_per_item": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "review": {
          "type": "string",
          "minLength": 1
        },
        "deployment": {
          "enum": ["local", "private_server", "both"]
        },
        "autosave": {
          "const": "atomic_per_item"
        }
      }
    },
    "ai_assistance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "default_origin",
        "record_model",
        "record_checkpoint_hash",
        "record_suggestion_id_when_exposed",
        "record_accept_edit_reject"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "default_origin": {
          "const": "manual"
        },
        "record_model": {
          "const": true
        },
        "record_checkpoint_hash": {
          "const": true
        },
        "record_suggestion_id_when_exposed": {
          "const": true
        },
        "record_accept_edit_reject": {
          "const": true
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotation_id",
        "revision_id",
        "annotator_id",
        "protocol_version",
        "source_hash",
        "frame_index_or_time",
        "coordinate_convention_and_units",
        "created_at",
        "updated_at",
        "review_state"
      ],
      "properties": {
        "annotation_id": {
          "const": "required"
        },
        "revision_id": {
          "const": "required"
        },
        "annotator_id": {
          "const": "required"
        },
        "protocol_version": {
          "const": "required"
        },
        "source_hash": {
          "const": "required"
        },
        "frame_index_or_time": {
          "const": "required"
        },
        "coordinate_convention_and_units": {
          "const": "required"
        },
        "created_at": {
          "const": "required"
        },
        "updated_at": {
          "const": "required"
        },
        "review_state": {
          "const": "required"
        }
      }
    },
    "exports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json_schema",
        "round_trip_required",
        "protocol_locked_before_reliability_sample"
      ],
      "properties": {
        "json_schema": {
          "const": "annotation-spec-1.3.0.schema.json"
        },
        "round_trip_required": {
          "const": true
        },
        "protocol_locked_before_reliability_sample": {
          "const": true
        }
      }
    }
  }
}
