{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "research-with-ai-domains",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SITE_ORIGIN": "https://research-with-ai-omar-2026.omarsc.chatgpt.site"
  },
  "routes": [
    {
      "pattern": "researchwithai.omarchoudhry.co.uk",
      "custom_domain": true
    },
    {
      "pattern": "agenticresearch.omarchoudhry.co.uk",
      "custom_domain": true
    },
    {
      "pattern": "interactivepaper.omarchoudhry.co.uk",
      "custom_domain": true
    },
    {
      "pattern": "annotate.omarchoudhry.co.uk",
      "custom_domain": true
    }
  ]
}
